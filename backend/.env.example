# ==========================================
# Inkloom AI - Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=inkloom-super-secure-jwt-signing-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Primary: PostgreSQL database named 'inkloom_ai'
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkloom_ai
# SQLite fallback is automatically used if PostgreSQL is unreachable during initial local setup:
# SQLITE_FALLBACK_URL=sqlite:///./inkloom_ai.db

# Storage Provider Configuration
STORAGE_BACKEND=local
# Options: 'local' or 'supabase'
LOCAL_STORAGE_DIR=./storage_data

# Supabase Configuration (Optional - for managed auth & private object storage)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-publishable-or-anon-key
# SUPABASE_SERVICE_KEY=your-private-service-role-key
# SUPABASE_STORAGE_BUCKET=inkloom-private-assets

# External AI Extraction Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
